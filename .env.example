# Copy this file to .env and fill in real values from your Supabase
# project (Project Settings -> API). Never commit the real .env file.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Optional: powers the "Analyze" button in the Threat Inspection panel
# (AI-written root-cause/remediation report for a flagged flow). Get a
# key from platform.openai.com. Without this set, the button shows a
# clear "not configured" message instead of failing silently.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4
